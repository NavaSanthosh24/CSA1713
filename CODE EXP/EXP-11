
def is_valid(region, color, assignment, graph):
    for neighbor in graph[region]:
        if assignment.get(neighbor) == color:
            return False
    return True


def map_coloring(graph, colors, assignment):
    if len(assignment) == len(graph):
        return True

    # Select an uncolored region
    region = next(
        region for region in graph
        if region not in assignment
    )

    # Try each available color
    for color in colors:
        if is_valid(region, color, assignment, graph):
            assignment[region] = color

            if map_coloring(graph, colors, assignment):
                return True

            # Backtrack
            del assignment[region]

    return False


graph = {
    'A': ['B', 'C'],
    'B': ['A', 'C', 'D'],
    'C': ['A', 'B', 'D'],
    'D': ['B', 'C']
}

colors = ['Red', 'Green', 'Blue']
assignment = {}

if map_coloring(graph, colors, assignment):
    print("Map Coloring Solution:")
    for region, color in assignment.items():
        print(region, ":", color)
else:
    print("No solution exists")
