
def tsp_greedy(distance, start):
    current = start
    visited = [start]
    total_distance = 0

    while len(visited) < len(distance):
        nearest = None
        min_distance = float('inf')

        for city in distance[current]:
            if city not in visited:
                if distance[current][city] < min_distance:
                    min_distance = distance[current][city]
                    nearest = city

        total_distance += min_distance
        current = nearest
        visited.append(current)

    # Return to the starting city
    total_distance += distance[current][start]
    visited.append(start)

    print("Route:", " -> ".join(visited))
    print("Total Distance:", total_distance)


# Distance between cities
distance = {
    'A': {'B': 10, 'C': 15, 'D': 20},
    'B': {'A': 10, 'C': 35, 'D': 25},
    'C': {'A': 15, 'B': 35, 'D': 30},
    'D': {'A': 20, 'B': 25, 'C': 30}
}

tsp_greedy(distance, 'A')
