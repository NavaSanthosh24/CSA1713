
def print_board(board):
    for i in range(0, 9, 3):
        print(" | ".join(board[i:i+3]))
        if i < 6:
            print("--+---+--")

def check_winner(board, player):
    win_positions = [
        (0, 1, 2), (3, 4, 5), (6, 7, 8),
        (0, 3, 6), (1, 4, 7), (2, 5, 8),
        (0, 4, 8), (2, 4, 6)
    ]
    return any(
        all(board[i] == player for i in line)
        for line in win_positions
    )

board = [" "] * 9
player = "X"

while True:
    print_board(board)
    try:
        position = int(input(
            f"Player {player}, enter position (1-9): "
        ))
    except ValueError:
        print("Enter a valid number!")
        continue

    if position < 1 or position > 9 or board[position-1] != " ":
        print("Invalid position! Try again.")
        continue

    board[position-1] = player

    if check_winner(board, player):
        print_board(board)
        print(f"Player {player} wins!")
        break

    if " " not in board:
        print_board(board)
        print("It's a draw!")
        break

    player = "O" if player == "X" else "X"
